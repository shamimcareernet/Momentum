<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Momentum'26 | Beyond Branch. Beyond Degree. Beyond Code.</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* =========================================
           ROOT VARIABLES & DESIGN SYSTEM
        ========================================= */
        :root {
            /* Brand Colors */
            --brand-blue: #34c3e8;
            --brand-red: #e21e38;
            --brand-yellow: #ffc10e;
            --dark-bg: #0d0d21;
            
            /* Gradients */
            --gradient-primary: linear-gradient(90deg, var(--brand-blue) 0%, var(--brand-red) 68%, var(--brand-yellow) 100%);
            
            /* UI Colors */
            --bg-light: #fafafa;
            --text-main: #0f172a;
            --text-muted: #475569;
            --text-light: #f8fafc;
            
            /* Glassmorphism */
            --glass-bg: rgba(255, 255, 255, 0.6);
            --glass-border: rgba(255, 255, 255, 0.8);
            --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.05);
            
            --glass-dark-bg: rgba(255, 255, 255, 0.05);
            --glass-dark-border: rgba(255, 255, 255, 0.1);
        }

        /* =========================================
           RESET & BASE
        ========================================= */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            background-color: var(--bg-light);
            color: var(--text-main);
            /* Updated Font */
            font-family: 'Manrope', sans-serif;
            font-size: 16px; 
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, h5, h6, .font-display {
            font-family: 'Manrope', sans-serif;
            line-height: 1.2;
        }

        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        button { cursor: pointer; border: none; font-family: inherit; }
        
        img, video { max-width: 100%; height: auto; display: block; }

        /* =========================================
           LAYOUT & SPACING
        ========================================= */
        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            position: relative;
            z-index: 10;
        }

        section {
            position: relative;
            padding: 60px 0px; 
        }

        .dark-section {
            background-color: var(--dark-bg);
            color: var(--text-light);
        }

        /* Grid Utilities */
        .grid { display: grid; gap: 24px; }
        .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
        .grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
        .grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
        .grid-cols-5 { grid-template-columns: repeat(5, 1fr); }

        @media (max-width: 1024px) {
            .lg-grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
            .grid-cols-4, .grid-cols-5 { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 768px) {
            .grid-cols-2, .grid-cols-3, .lg-grid-cols-2, .grid-cols-4, .grid-cols-5 { grid-template-columns: 1fr; }
        }

        /* Flex Utilities */
        .flex { display: flex; }
        .flex-col { flex-direction: column; }
        .flex-wrap { flex-wrap: wrap; }
        .items-center { align-items: center; }
        .justify-center { justify-content: center; }
        .justify-between { justify-content: space-between; }
        .gap-2 { gap: 8px; }
        .gap-4 { gap: 16px; }
        .gap-6 { gap: 24px; }
        
        @media (min-width: 768px) {
            .md-flex-row { flex-direction: row; }
        }

        /* =========================================
           TYPOGRAPHY UTILITIES
        ========================================= */
        .text-center { text-align: center; }
        .text-gradient {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .text-sm { font-size: 0.875rem; }
        .text-lg { font-size: 1.125rem; }
        .text-xl { font-size: 1.25rem; }
        .text-2xl { font-size: 1.5rem; }
        .text-3xl { font-size: 1.875rem; }
        .text-4xl { font-size: 2.25rem; }
        .text-5xl { font-size: 3rem; }
        .text-7xl { font-size: 4.5rem; }
        .font-bold { font-weight: 700; }
        .font-semibold { font-weight: 600; }
        .tracking-tight { letter-spacing: -0.025em; }
        .uppercase { text-transform: uppercase; letter-spacing: 0.05em; }
        
        @media (min-width: 768px) { .text-7xl { font-size: 6rem; } }
        @media (min-width: 1024px) { .text-7xl { font-size: 8rem; } }

        /* =========================================
           HEADER & NAVIGATION
        ========================================= */
        .site-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 20px 0;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            background: rgba(13, 13, 33, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .site-header.scrolled {
            background: rgba(13, 13, 33, 0.9);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            padding: 12px 0;
            border-bottom-color: rgba(52, 195, 232, 0.2);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo img {
            height: 36px;
            transition: transform 0.3s ease;
        }
        
        .brand-logo:hover img {
            transform: scale(1.05);
        }

        .nav-links {
            display: flex;
            gap: 32px;
            align-items: center;
        }

        .nav-links a {
            color: #fff;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-links a:not(.btn):hover {
            color: var(--brand-blue);
        }
        
        .nav-links a:not(.btn)::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--brand-blue);
            transition: width 0.3s ease;
        }
        
        .nav-links a:not(.btn):hover::after {
            width: 100%;
        }

        .mobile-menu-btn {
            display: none;
            color: #fff;
            font-size: 24px;
            background: none;
        }

        @media (max-width: 992px) {
            .nav-links { display: none; }
            .mobile-menu-btn { display: block; }
        }

        /* =========================================
           GLASS COMPONENTS
        ========================================= */
        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.4));
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid #ffffff;
            box-shadow: var(--glass-shadow);
            border-radius: 24px;
            padding: 24px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px 0 rgba(52, 195, 232, 0.15);
            border-color: rgba(52, 195, 232, 0.5);
        }

        .dark-section .glass-card {
            background: var(--glass-dark-bg);
            border-color: var(--glass-dark-border);
            color: var(--text-light);
        }
        
        .dark-section .glass-card:hover {
            background: rgba(255,255,255,0.1);
            border-color: var(--brand-blue);
        }

        /* =========================================
           BUTTONS & BADGES
        ========================================= */
        .btn, .btn-submit {
            position: relative;
            z-index: 1;
            border: none !important; /* Managed by gradient border */
        }

        /* Gradient Border Setup for ALL CTAs */
        .btn::after, .btn-submit::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 2px; /* Gradient border thickness */
            background: var(--gradient-primary);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: destination-out;
            mask-composite: exclude;
            z-index: -1;
            pointer-events: none;
        }

        .btn {
            display: inline-block;
            padding: 16px 32px;
            border-radius: 50px;
            font-weight: 600;
            text-align: center;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background-color: var(--text-main);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--gradient-primary);
            box-shadow: 0 0 20px rgba(52, 195, 232, 0.4);
            color: #fff;
        }
        
        /* Make ::after transparent on hover if primary is fully filled */
        .btn-primary:hover::after {
            opacity: 0;
        }

        .btn-glass {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            color: var(--text-main);
        }

        .btn-glass:hover {
            background: #fff;
            box-shadow: var(--glass-shadow);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-main);
        }

        .dark-section .btn-outline {
            color: #fff;
        }

        .btn-outline:hover {
            background: rgba(52, 195, 232, 0.05);
        }

        .badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* =========================================
           HERO SECTION
        ========================================= */
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 0;
            background: #000;
        }

        /* CSS trick to make iframe cover the background */
        .hero-video-wrapper {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
        }

        .hero-video-bg {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100vw;
            height: 56.25vw; /* 16:9 aspect ratio */
            min-height: 100vh;
            min-width: 177.77vh; /* 16:9 aspect ratio */
            transform: translate(-50%, -50%);
            border: none;
            pointer-events: none; /* Prevents interaction with YT play button */
        }

        .hero-overlays {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        .hero-overlay-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent 70%, rgba(0,0,0,0.6));
        }

        /* =========================================
           ABOUT SECTION
        ========================================= */
        .about-grid {
            display: flex;
            flex-direction: column;
            gap: 60px;
        }
        @media (min-width: 1024px) {
            .about-grid { flex-direction: row; }
            .about-title { width: 33.333%; position: sticky; top: 120px; align-self: flex-start; }
            .about-content { width: 66.666%; }
        }
        
        .prose p { margin-bottom: 2rem; font-size: 1.125rem; color: var(--text-muted); font-weight: 500;}
        .prose .highlight-box {
            border-left: 4px solid var(--brand-blue);
            margin: 2rem 0;
        }
        .prose .glass-box {
            text-align: center;
            padding: 40px;
            border-radius: 24px;
            margin: 3rem 0;
            box-shadow: var(--glass-shadow);
        }
        .prose ul li { margin-bottom: 1rem; display: flex; align-items: center; gap: 12px; }
        .bullet { width: 8px; height: 8px; border-radius: 50%; background: var(--brand-blue); }

        /* =========================================
           TIMELINE (AGENDA) - IMPROVED DOTS
        ========================================= */
        .timeline-wrapper {
            position: relative;
            max-width: 800px;
            margin: 0 auto 0 20px;
        }
        
        @media (min-width: 768px) {
            .timeline-wrapper { margin: 0 auto; }
        }

        .timeline-wrapper::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 10px;
            bottom: 10px;
            width: 2px;
            background: #e2e8f0;
            z-index: 1;
        }

        .timeline-item {
            position: relative;
            padding-left: 60px;
            margin-bottom: 40px;
            display: flex;
            flex-direction: column;
        }

        .timeline-dot {
            position: absolute;
            left: 7px;
            top: 14px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--bg-light);
            border: 3px solid var(--brand-blue);
            box-shadow: 0 0 15px rgba(52, 195, 232, 0.3);
            z-index: 2;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        .timeline-dot::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 10px;
            height: 10px;
            background: var(--brand-blue);
            border-radius: 50%;
            transition: all 0.4s ease;
        }

        .timeline-item:hover .timeline-dot {
            transform: scale(1.15);
            box-shadow: 0 0 25px rgba(52, 195, 232, 0.6);
            border-width: 4px;
        }

        .timeline-card {
            width: 100%;
        }

        .timeline-card.break {
            background: transparent;
            border: 2px dashed #e2e8f0;
            box-shadow: none;
            text-align: center;
            padding: 16px;
        }

        .timeline-time {
            color: var(--brand-blue);
            font-weight: 700;
            font-size: 0.875rem;
            margin-bottom: 4px;
            display: block;
        }

        .timeline-card.finale {
            border: 1px solid var(--brand-yellow);
            box-shadow: 0 0 20px rgba(255, 193, 14, 0.15);
        }

        .timeline-card.dark {
            background: var(--dark-bg);
            color: #fff;
        }
        
        .dot-break {
            border-color: #cbd5e1 !important;
            background: #f8fafc !important;
            box-shadow: none !important;
        }
        .dot-break::before { background: #cbd5e1 !important; }
        
        .dot-red { border-color: var(--brand-red) !important; }
        .dot-red::before { background: var(--brand-red) !important; }
        .timeline-item:hover .dot-red { box-shadow: 0 0 25px rgba(226, 30, 56, 0.6) !important; }
        
        .dot-yellow { border-color: var(--brand-yellow) !important; }
        .dot-yellow::before { background: var(--brand-yellow) !important; }
        .timeline-item:hover .dot-yellow { box-shadow: 0 0 25px rgba(255, 193, 14, 0.6) !important; }

        .dot-dark { border-color: var(--dark-bg) !important; }
        .dot-dark::before { background: var(--dark-bg) !important; }

        /* =========================================
           HACKVEGA & REPORT SECTION
        ========================================= */
        .premium-border-card {
            background: linear-gradient(var(--dark-bg), var(--dark-bg)) padding-box,
                        var(--gradient-primary) border-box;
            border: 2px solid transparent;
            border-radius: 32px;
            padding: 40px;
            position: relative;
            overflow: hidden;
            color: #fff;
        }

        .code-bg {
            position: absolute;
            inset: 0;
            opacity: 0.2;
            font-family: monospace;
            font-size: 12px;
            color: var(--brand-blue);
            padding: 20px;
            line-height: 1.8;
            transition: opacity 0.5s ease;
            pointer-events: none;
        }
        
        .premium-border-card:hover .code-bg { opacity: 0.4; }

        .report-animation-bars {
            width: 100%;
            height: 160px;
            background: #fff;
            border-radius: 16px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            transform: rotate(2deg);
            transition: transform 0.5s ease;
        }

        .report-card:hover .report-animation-bars { transform: rotate(0deg); }

        /* =========================================
           MARQUEE PARTNERS
        ========================================= */
        .marquee-wrapper {
            position: relative;
            width: 100%;
            overflow: hidden;
            padding: 24px 0;
            border-top: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
        }

        .marquee-track {
            display: flex;
            width: max-content;
            animation: marquee 30s linear infinite;
            align-items: center;
            gap: 48px;
        }

        .marquee-track.reverse {
            animation-direction: reverse;
            animation-duration: 40s;
        }

        .marquee-track img {
            height: 48px;
            object-fit: contain;
            mix-blend-mode: multiply;
            opacity: 0.7;
            transition: opacity 0.3s;
        }
        
        .marquee-track img:hover { opacity: 1; }

        /* =========================================
           FORM ELEMENTS
        ========================================= */
        .form-group {
            position: relative;
            margin-bottom: 24px;
        }

        .input-field {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 1px solid rgba(255,255,255,0.3);
            padding: 12px 0;
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.3s;
            font-family: 'Manrope', sans-serif;
        }

        .input-field:focus {
            border-bottom-color: var(--brand-blue);
        }

        .input-label {
            position: absolute;
            left: 0;
            top: 12px;
            color: #94a3b8;
            transition: all 0.3s ease;
            pointer-events: none;
        }

        .input-field:focus ~ .input-label,
        .input-field:not(:placeholder-shown) ~ .input-label {
            transform: translateY(-20px) scale(0.85);
            color: var(--brand-blue);
        }

        .btn-submit {
            width: 100%;
            padding: 16px;
            background: #fff;
            color: var(--dark-bg);
            border-radius: 12px;
            font-weight: 700;
            margin-top: 16px;
            transition: all 0.3s ease;
        }

        .btn-submit:hover {
            background: var(--gradient-primary);
            color: #fff;
            box-shadow: 0 0 25px rgba(52, 195, 232, 0.4);
        }
        
        .btn-submit:hover::after {
            opacity: 0;
        }

        /* =========================================
           FOOTER
        ========================================= */
        .site-footer {
            background-color: var(--dark-bg);
            color: #fff;
            padding: 80px 0 40px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }
        
        @media (max-width: 768px) {
            .footer-grid { grid-template-columns: 1fr; }
        }
        
        .footer-logo {
            height: 48px;
            margin-bottom: 24px;
        }
        
        .footer-desc {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.875rem;
            max-width: 400px;
            line-height: 1.8;
        }
        
        .footer-title {
            font-family: 'Manrope', sans-serif;
            font-weight: 700;
            margin-bottom: 24px;
            font-size: 1.25rem;
            color: var(--brand-blue);
        }
        
        .footer-links li {
            margin-bottom: 12px;
        }
        
        .footer-links a {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.875rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }
        
        .footer-links a:hover {
            color: var(--brand-blue);
        }
        
        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.875rem;
            color: rgba(255, 255, 255, 0.5);
            flex-wrap: wrap;
            gap: 16px;
        }

        /* =========================================
           ANIMATIONS & UTILS
        ========================================= */
        @keyframes marquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        .animate-float { animation: float 6s ease-in-out infinite; }
        
        .noise-bg {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.03;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        #cursor-glow {
            position: fixed;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(52,195,232,0.15) 0%, rgba(226,30,56,0.05) 40%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            transform: translate(-50%, -50%);
            transition: opacity 0.3s ease;
        }

        /* Hide scrollbar for lenis */
        html.lenis { height: auto; }
        .lenis.lenis-smooth { scroll-behavior: auto !important; }
        .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
        .lenis.lenis-stopped { overflow: hidden; }
        .lenis.lenis-scrolling iframe { pointer-events: none; }
        
        /* Helper Spacing */
        .mb-2 { margin-bottom: 8px; }
        .mb-4 { margin-bottom: 16px; }
        .mb-6 { margin-bottom: 24px; }
        .mb-8 { margin-bottom: 32px; }
        .mb-12 { margin-bottom: 48px; }
        .mb-16 { margin-bottom: 64px; }
        .mt-8 { margin-top: 32px; }
        .py-4 { padding-top: 16px; padding-bottom: 16px; }
        .w-full { width: 100%; }
        .block { display: block; }
        .inline-block { display: inline-block; }
        
    </style>
</head>
<body>

    <div class="noise-bg"></div>
    <div id="cursor-glow"></div>

    <header class="site-header" id="header">
        <div class="container nav-container">
            <a href="#" class="brand-logo">
                <img src="https://hirepro.in/wp-content/uploads/2026/02/HirePro_Logo.svg" alt="HirePro Logo">
            </a>
            <button class="mobile-menu-btn">☰</button>
            <nav class="nav-links">
                <a href="#about">About</a>
                <a href="#legacy">Legacy</a>
